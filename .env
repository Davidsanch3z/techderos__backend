# ==============================================
# MICROSERVICIO DE USUARIOS - CONFIGURACIÓN
# ==============================================
# Copia este archivo como .env y configura los valores

# ==============================================
# APLICACIÓN
# ==============================================
NODE_ENV=development
PORT=3002
APP_NAME=Gestión Comercial
LOG_LEVEL=info

# URL del frontend para CORS y enlaces en emails
FRONTEND_URL=http://localhost:3000

# Origenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ==============================================
# BASE DE DATOS POSTGRESQL - SUPABASE
# ==============================================
DB_HOST=aws-0-us-east-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.ycjfwymfkfcwtgvcedwt
DB_PASSWORD=TywoMgMwD9zSbhMo

# URL completa de conexión (alternativa)
DATABASE_URL=postgresql://postgres.ycjfwymfkfcwtgvcedwt:TywoMgMwD9zSbhMo@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# Configuración del pool de conexiones para Supabase
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000
DB_STATEMENT_TIMEOUT=30000
DB_QUERY_TIMEOUT=30000

# SSL requerido para Supabase
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SSL_MODE=require

# ==============================================
# JWT (JSON WEB TOKENS)
# ==============================================
JWT_SECRET=desarrollo_jwt_secret_muy_largo_y_seguro_para_supabase_2025
JWT_REFRESH_SECRET=desarrollo_refresh_secret_muy_largo_y_diferente_2025

# Tiempos de expiración
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Configuración adicional
JWT_ISSUER=usuarios-service
JWT_AUDIENCE=gestion-comercial
JWT_ALGORITHM=HS256
JWT_CLOCK_TOLERANCE=30

# ==============================================
# EMAIL / SMTP
# ==============================================
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion
EMAIL_FROM=noreply@gestioncomercial.com

# Para Gmail, usar contraseña de aplicación:
# https://support.google.com/accounts/answer/185833

# Para SendGrid (alternativo):
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=tu_sendgrid_api_key

# Para Outlook/Hotmail (alternativo):
# EMAIL_PROVIDER=outlook
# EMAIL_HOST=smtp-mail.outlook.com

# ==============================================
# REDIS (DESHABILITADO PARA DESARROLLO CON SUPABASE)
# ==============================================
# Para desarrollo inicial, deshabilitamos Redis
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# ==============================================
# RATE LIMITING
# ==============================================
# Deshabilitado para desarrollo inicial
SKIP_RATE_LIMIT=true

# ==============================================
# LOGGING
# ==============================================
# Nivel de logging: error, warn, info, http, debug
LOG_LEVEL=info

# Habilitar logging de queries de base de datos (solo desarrollo)
LOG_DB_QUERIES=false

# ==============================================
# DESARROLLO/DEBUG
# ==============================================
# Habilitar stack traces en respuestas de error (solo desarrollo)
SHOW_ERROR_STACK=true

# ==============================================
# CONFIGURACIÓN POR AMBIENTE
# ==============================================

# DESARROLLO
# NODE_ENV=development
# JWT_ACCESS_EXPIRY=1h
# JWT_REFRESH_EXPIRY=30d
# LOG_LEVEL=debug
# SKIP_RATE_LIMIT=true

# STAGING/TESTING
# NODE_ENV=staging
# JWT_ACCESS_EXPIRY=30m
# JWT_REFRESH_EXPIRY=3d
# LOG_LEVEL=info

# PRODUCCIÓN
# NODE_ENV=production
# JWT_ACCESS_EXPIRY=15m
# JWT_REFRESH_EXPIRY=7d
# LOG_LEVEL=warn
# DB_SSL_REJECT_UNAUTHORIZED=true
# SKIP_RATE_LIMIT=false

# ==============================================
# NOTAS IMPORTANTES
# ==============================================
# 1. NUNCA subir este archivo .env al control de versiones
# 2. Usar secretos seguros en producción (64+ caracteres)
# 3. Configurar SSL/TLS para base de datos en producción
# 4. Usar contraseñas de aplicación para Gmail
# 5. Considerar usar variables de entorno del sistema en producción
# 6. Revisar logs regularmente para detectar problemas
# 7. Configurar monitoreo y alertas en producción

# ==============================================
# COMANDOS ÚTILES
# ==============================================
# Generar secreto JWT:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# Verificar conexión a base de datos:
# npm run db:test

# Iniciar en modo desarrollo:
# npm run dev

# Ver logs en tiempo real:
# npm run logs

# Ejecutar migraciones:
# npm run db:migrate

# Ejecutar seeds:
# npm run db:seed
