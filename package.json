{
  "name": "usuarios-service",
  "version": "1.0.0",
  "description": "Microservicio de gestión de usuarios, autenticación y roles",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "db:migrate": "node src/utils/migrate.js",
    "db:seed": "node src/utils/seed.js"
  },
  "keywords": [
    "microservice",
    "authentication",
    "users",
    "jwt",
    "node.js",
    "express"
  ],
  "author": "Equipo de Desarrollo",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "joi": "^17.9.2",
    "pg": "^8.11.3",
    "redis": "^4.6.8",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "morgan": "^1.10.0",
    "winston": "^3.10.0",
    "nodemailer": "^6.9.4",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.2",
    "supertest": "^6.3.3",
    "eslint": "^8.45.0",
    "@eslint/js": "^8.45.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
